/** Generated by the offline configurator. Never copy an old edition's Script Properties. */
function conferenceEdition_() { return "__ACADIA_VALUE_edition__"; }

function conferenceDate_(heading) {
  const text=String(heading||''), edition=conferenceEdition_();
  const iso=text.match(/\b(\d{4})-(\d{2})-(\d{2})\b/);
  let year,month,day;
  if(iso){year=Number(iso[1]);month=Number(iso[2]);day=Number(iso[3]);}
  else {
    const months=['january','february','march','april','may','june','july','august','september','october','november','december'];
    const match=text.match(/\b(January|February|March|April|May|June|July|August|September|October|November|December|Jan\.?|Feb\.?|Mar\.?|Apr\.?|Jun\.?|Jul\.?|Aug\.?|Sep\.?|Sept\.?|Oct\.?|Nov\.?|Dec\.?)\s+(\d{1,2})(?:,?\s+(\d{4}))?/i);
    if(!match)return null;
    month=months.findIndex(m=>m.startsWith(match[1].toLowerCase().replace('.','')))+1;
    day=Number(match[2]);year=Number(match[3]||edition.year);
  }
  const date=new Date(Date.UTC(year,month-1,day));
  if(year!==Number(edition.year)||date.getUTCFullYear()!==year||date.getUTCMonth()!==month-1||date.getUTCDate()!==day)return null;
  return year+'-'+String(month).padStart(2,'0')+'-'+String(day).padStart(2,'0');
}

/** Run only in a newly created project belonging to the new organizing committee. */
function RUN_CONFIGURE_NEW_INSTALLATION() {
  const c=conferenceEdition_(),r=c.resources,p=PropertiesService.getScriptProperties();
  const active=Session.getActiveUser().getEmail(),effective=Session.getEffectiveUser().getEmail();
  if(!active||active!==effective)throw new Error('Run from the Apps Script editor as the project owner.');
  const marker=p.getProperty('ACADIA_TOOLKIT_INSTALLATION');
  if(marker&&marker!==String(c.year))throw new Error('This project belongs to a different edition. Create a new project.');
  if(!marker&&Object.keys(p.getProperties()).length)throw new Error('This project has existing Script Properties. Use a new empty project.');
  const props={ACADIA_TOOLKIT_INSTALLATION:String(c.year),GUIDE_ENABLED:'false'};
  if(typeof DEFAULTS!=='undefined'){
    if(!r.authorMasterId||!r.rootId)throw new Error('Create the template kit and import its configuration first.');
    props.MASTER_SPREADSHEET_ID=r.authorMasterId;
    props.CFG_ROOT_FOLDER_ID=r.rootId;
    props.CFG_CONTACT_EMAIL=c.contactEmail;
    props.CFG_REGISTRATION_URL=c.registrationUrl;
    props.CFG_CONSENT_PDF_FILE_ID=r.consentPdfId||'';
    props.CFG_VISA_LETTER_TEMPLATE_DOC_ID=r.visaTemplateId||'';
    if(r.presentationId)props.ACADIA_PRESENTATION_ADMIN_ID=r.presentationId;
    if(r.presentationRootId)props.ACADIA_PRESENTATION_ROOT_ID=r.presentationRootId;
  }
  p.setProperties(props,false);
  if(typeof REVIEWER_PORTAL!=='undefined'){
    ensureWorkbook_();ensureSettings_();
    const settings={CONTACT_EMAIL:c.contactEmail,AUTHOR_PORTAL_URL:c.authorPortalUrl,
      CERTIFICATE_TEMPLATE_FILE_ID:r.reviewerTemplateId||'',
      WORKSHOP_TEMPLATE_FILE_ID:r.workshopTemplateId||'',INSTRUCTOR_TEMPLATE_FILE_ID:r.instructorTemplateId||'',
      PRESENTER_TEMPLATE_FILE_ID:r.presenterCertificateTemplateId||'',CHAIR_TEMPLATE_FILE_ID:r.chairTemplateId||'',
      VOLUNTEER_TEMPLATE_FILE_ID:r.volunteerTemplateId||'',AWARD_TEMPLATE_FILE_ID:r.awardTemplateId||'',
      PRESENTER_SOURCE_SPREADSHEET_ID:r.presentationId||'',PRESENTER_AUTHOR_SPREADSHEET_ID:r.authorMasterId||'',
      CHAIR_SOURCE_SPREADSHEET_ID:r.chairCoordinationId||''};
    ['WORKSHOP','INSTRUCTOR','PRESENTER','CHAIR','VOLUNTEER','AWARD'].forEach(k=>{settings[k+'_OUTPUT_FOLDER_ID']=r.certificateOutputId||'';});
    ['WORKSHOP','INSTRUCTOR','PRESENTER','CHAIR','VOLUNTEER','AWARDS'].forEach(k=>{settings[k+'_ENABLED']='FALSE';});
    Object.keys(settings).forEach(k=>updateSetting_(k,settings[k],'Configured by ACADIA Conference Toolkit'));
  }
  console.log('Configuration installed. No email sent, no calendar created, no triggers installed. Follow the module guide.');
}
