/** Read-only checks for this edition. Run from the Apps Script editor. */
function RUN_CHECK_INSTALLATION() {
  const active=Session.getActiveUser().getEmail(),effective=Session.getEffectiveUser().getEmail();
  if(!active||active!==effective)throw new Error('Run this check from the Apps Script editor as the project owner.');
  const edition=conferenceEdition_(),schemas=[{"key":"acceptedId","tabs":[{"name":"Full Papers","headers":["ID","Title","Authors","All Reviewer Comments"]},{"name":"Projects","headers":["ID","Title","Authors","All Reviewer Comments"]},{"name":"Field Notes","headers":["ID","Title","Authors","All Reviewer Comments"]},{"name":"PhD Workshop","headers":["ID","Title","Authors","All Reviewer Comments"]},{"name":"Book Forum","headers":["ID","Title","Authors","All Reviewer Comments"]}]},{"key":"authorMasterId","tabs":[{"name":"Settings","headers":["Key","Value","Notes"]},{"name":"Submissions","headers":["Paper ID","Original Title","Normalized Original Title","Final Title","Track","Volume","Corresponding Author","Corresponding Email","Presenting Author","Presenting Email","Submission Folder ID","Portal Enabled","Overall Status","Proof Version","Proof Due Label","Last Updated"]},{"name":"Task_Status","headers":["Paper ID","Task ID","Task Name","Status","Submitted At","Approved At","Action Required Note","Last Updated"]},{"name":"Task_Data","headers":["Paper ID","Task ID","Data JSON","Last Updated"]},{"name":"Reviewer_Feedback","headers":["Paper ID","Review Label","Reviewer Comment","Source","Imported At"]},{"name":"Authors","headers":["Paper ID","Position","Full Name","Email","Affiliation","ORCID","Corresponding","Presenting","Last Updated"]},{"name":"Website_Materials","headers":["Paper ID","Final Title","Category","Abstract","Keywords","Corresponding Email","Last Updated"]},{"name":"Website_Images","headers":["Paper ID","Image Slot","Drive File ID","File Name","Caption","Credit","Alt Text","Active","Last Updated"]},{"name":"File_Registry","headers":["Paper ID","Task ID","Role","Version","Drive File ID","File Name","Original File Name","MIME Type","Size Bytes","Parent Folder ID","Active","Uploaded At"]},{"name":"Folder_Registry","headers":["Paper ID","Folder Role","Folder ID","Folder Name","Last Updated"]},{"name":"Attendance","headers":["Paper ID","Attendance Confirmed","Presenter Name","Presenter Email","Confirmed At","Last Updated"]},{"name":"Registration","headers":["Paper ID","Registered Author","Registered Email","Confirmation Number","Receipt File ID","Unique Author Check","Last Updated"]},{"name":"Indexing_Status","headers":["Paper ID","Opened At","Confirmed","Confirmation Note","Confirmed At","Last Updated"]},{"name":"Proof_Comments","headers":["Timestamp","Paper ID","Paper Title","Proof Version","Page Number","Category","Location","Author Comment","Author Name","Resolution Status","Copyeditor Response","Resolved At","Form Response ID"]},{"name":"Activity_Log","headers":["Timestamp","Paper ID","Event","Task ID","Detail"]},{"name":"Visa_Letter_Log","headers":["Request ID","Generated At","Paper ID","Paper Title","Track","Author Name","Author Email","PDF File ID","PDF File Name","PDF URL","Archive Folder ID","Template File ID","Template File Name"]},{"name":"Admin_Dashboard","headers":["Paper ID","Title","Track","Reviewer Feedback","Metadata + Website","Camera-ready ZIP","Consent","Attendance","Indexing","Registration","Author Proof","Overall Status","Last Activity"]}]},{"key":"presentationId","tabs":[{"name":"Sessions","headers":["Session ID","Track","Subtheme","Session Title","Date","Start Time","End Time","Time Zone","Venue","Room","Chair","Folder ID","Chair Override"]},{"name":"Assignments","headers":["Paper ID","Session ID","Order","Presentation Start","Presentation End","Title","Authors","Presenter Name","Presenter Last Name","Schedule Source ID"]},{"name":"Uploads","headers":["Upload ID","Paper ID","Session ID","Presenter Name","Presenter Last Name","Title","File ID","File Name","Bytes","Version","Active","Uploaded At","Late","Folder ID","Original File Name"]},{"name":"Settings","headers":["Key","Value","Notes"]},{"name":"SessionContacts","headers":["Session ID","Session Title","Chair Name","Chair Email"]},{"name":"PresentationReminders","headers":["Key","Session ID","Session Start UTC","Paper IDs","Presenter Email","State","Attempted At","Sent At","Issue"]},{"name":"ReminderReadiness","headers":["Paper ID","Session ID","Session Start ({{city}})","Presenting Author","Presenting Email","Recipient Status","Chair Status","Action Needed"]}]},{"key":"scheduleId","tabs":[{"name":"Conference","headers":["Time / Day","Room / Paper ID","Session / Title / Author","Count / Notes",""]},{"name":"Workshops","headers":["Time / Day","Activity","Venue 1","Venue 2","Venue 3","Venue 4","Venue 5","Venue 6"]}]},{"key":"recognitionId","tabs":[{"name":"Settings","headers":["Key","Value","Notes"]},{"name":"Completed_Reviews","headers":["Submission ID","Paper Title","Reviewer Name","Reviewer Email","Status","Completed Date (EasyChair)","Unique Key"]},{"name":"Reviewer_Summary","headers":["Reviewer Name","Reviewer Email","Completed Review Count","Submission IDs","Reviewed Paper Titles","Normalized Name","Login Enabled"]},{"name":"Certificate_Log","headers":["Request ID","Generated At","Reviewer Name","Reviewer Email","Review Count","Submission IDs","Paper Titles","PDF File ID","PDF File Name","PDF URL","Template File ID","Data Fingerprint"]},{"name":"Reviewer_{{nextYear}}_Interest","headers":["Response Updated At","EasyChair Reviewer Name","EasyChair Reviewer Email","Preferred Name Prefix","Certificate Display Name","Willing to Review ACADIA {{nextYear}}","Completed Review Count","Submission IDs"]},{"name":"Workshop_Catalog","headers":["Workshop ID","Workshop Title","Workshop Dates","Workshop Location"]},{"name":"Workshop_Registrations","headers":["Registration ID","Attendee Name","Attendee Email","Workshop ID","Enabled"]},{"name":"Workshop_Instructors","headers":["Registration ID","Instructor Name","Name Aliases","Workshop ID","Enabled"]},{"name":"Workshop_Certificate_Log","headers":["Request ID","Generated At","Registration ID","Attendee Name","Attendee Email","Workshop ID","Workshop Title","PDF File ID","PDF File Name","Template File ID","Data Fingerprint"]},{"name":"Workshop_Instructor_Log","headers":["Request ID","Generated At","Registration ID","Instructor Name","Identity Name","Workshop ID","Workshop Title","PDF File ID","PDF File Name","Template File ID","Data Fingerprint"]},{"name":"Presentation_Confirmations","headers":["Paper ID","Status","Confirmed Presenter","Confirmed By","Confirmed At","Notes"]},{"name":"Presentation_Certificate_Log","headers":["Request ID","Generated At","Identity Key","Author Name","Author Email","Track","Paper IDs","Session IDs","PDF File ID","PDF File Name","Template File ID","Data Fingerprint"]},{"name":"Session_Chair_Certificate_Log","headers":["Request ID","Generated At","Identity Key","Chair Name","Chair Email","Session IDs","Session Count","Presentation Count","PDF File ID","PDF File Name","Template File ID","Data Fingerprint"]},{"name":"Volunteers","headers":["Volunteer ID","Full Name","Affiliation","Name Aliases","Enabled"]},{"name":"Volunteer_Certificate_Log","headers":["Request ID","Generated At","Volunteer ID","Full Name","Affiliation","PDF File ID","PDF File Name","Template File ID","Data Fingerprint"]},{"name":"Awards","headers":["Award ID","Award Name","Paper ID","Track","Award Work Title","Award Authors","Enabled"]},{"name":"Award_Certificate_Log","headers":["Request ID","Generated At","Identity Key","Recipient Name","Recipient Email","Award ID","Paper ID","Award Name","PDF File ID","PDF File Name","Template File ID","Data Fingerprint"]}]},{"key":"chairCoordinationId","tabs":[{"name":"Sessions","headers":["Session ID","Session title","Date","Start (ET)","End (ET)","Session chair","Chair email"]}]},{"key":"phdMonitorId","tabs":[{"name":"Submission Monitor","headers":["Paper ID","Title","Authors","Corresponding Author","Corresponding Email","Overall Status","Task 1 Metadata + Website","Task 2 Exhibition Poster","Poster File","Task 3 Copyright + Recording Consent","Consent File","Task 4 Attendance","Presenter","Task 5 Indexing","Task 6 Volunteer Preferences","Volunteer Preferences","Other Preference","Available Time Slots","Task 7 Conference Registration","Registration Confirmation File","Last Activity","Last Activity Detail","Last Updated","Submission Folder"]},{"name":"Activity Log","headers":["Timestamp","Paper ID","Title","Event","Task","Detail"]},{"name":"Volunteer Assignments","headers":["Paper ID","Title","Participant / Authors","Volunteer Preferences","Other Preference","Available Time Slots","Preference Submitted","Assigned Role","Shift / Date / Time","Coordinator Notes","Assignment Status"]}]}];
  if(typeof ACMS_EDITOR!=='undefined'){
    try {const state=acmsReadContentStore_();DriveApp.getFolderById(edition.resources.contentFolderId);return {module:'content-editor',year:edition.year,ok:state.writerScriptId===ScriptApp.getScriptId(),revision:state.revision};}
    catch(error){return {module:'content-editor',year:edition.year,ok:false,problem:'Check content file access, edition, and editor initialization.'};}
  }
  const moduleName=typeof DEFAULTS!=='undefined'?'author-portal':typeof PROGRAM_CONFIG!=='undefined'?'conference-program':typeof REVIEWER_PORTAL!=='undefined'?'recognition-portal':typeof MAIL_SENDER_!=='undefined'?'presentation-reminders':'calendar-sync';
  const requirements={
    'author-portal':['authorMasterId','acceptedId','presentationId'],
    'conference-program':['authorMasterId','scheduleId'],
    'recognition-portal':['recognitionId'],
    'presentation-reminders':['authorMasterId','presentationId','scheduleId'],
    'calendar-sync':['scheduleId']
  };
  const render=value=>String(value).replace(/\{\{([A-Za-z0-9_]+)\}\}/g,(_,key)=>String(edition[key]??''));
  const checks=[];
  requirements[moduleName].forEach(key=>{
    const id=edition.resources[key];
    if(!id){checks.push({workbook:key,ok:false,problem:'Resource ID is missing.'});return;}
    try {
      const book=SpreadsheetApp.openById(id),spec=schemas.find(b=>b.key===key);
      spec.tabs.forEach(tab=>{
        const name=render(tab.name),sheet=book.getSheetByName(name);
        if(!sheet){checks.push({workbook:key,tab:name,ok:false,problem:'Required tab is missing.'});return;}
        const expected=tab.headers.map(render),actual=sheet.getRange(1,1,1,expected.length).getDisplayValues()[0];
        const ok=expected.every((h,i)=>h===String(actual[i]||''));
        checks.push({workbook:key,tab:name,ok:ok,dataRows:Math.max(0,sheet.getLastRow()-1),problem:ok?'':'Header names or column order differ from the generated template.'});
      });
    }catch(error){checks.push({workbook:key,ok:false,problem:'Cannot read this workbook. Check its ID and the executing account’s access.'});}
  });
  const result={module:moduleName,year:edition.year,ok:checks.every(c=>c.ok),checks:checks};
  console.log(JSON.stringify(result,null,2));return result;
}
